/**
 * @file  device_config.h.example
 * @brief Per-device settings. Copy to device_config.h (same folder) and fill in.
 *
 * device_config.h is in .gitignore: it holds this device's password and SIM
 * PIN and must never be committed. Build one firmware image per device.
 *
 * Device login: ask the server team to run `./add-device.sh <id>` on the
 * broker (/root/mqtt). It creates the login and prints the password once; the
 * password is also kept in Infisical (Nodewave / prod / /mqtt,
 * MQTT_DEVICE_<ID>_PASSWORD).
 */

#ifndef DEVICE_CONFIG_H
#define DEVICE_CONFIG_H

/* Device id = MQTT username = client id = topic prefix.
 * Lowercase letters, digits and '-' only, 2-31 characters. */
#define DEVICE_ID        "dev01"

/* Password from ./add-device.sh <DEVICE_ID> */
#define MQTT_PASSWORD    "paste-the-device-password-here"

/* SIM card */
#define SIM_PIN          ""            /* "" if the SIM has no PIN */
#define SIM_APN          "safaricom"

#endif /* DEVICE_CONFIG_H */
